<h1>Перекладаємо в інше місце</h1>

<%= form_with model: @item_storage do |f| %>
    <% if @item_storage.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@item_storage.errors.count, "error") %> prohibited this item_storage from being saved:</h2>

      <ul>
      <% @item_storage.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :item_id, "Річ" %><br>
    <%= f.collection_select :item_id, Item.all, :id, :name, prompt: "Оберіть річ" %>
  </div>

  <div>
    <%= f.label :item_place_id, "Місце зберігання" %><br>
    <%= f.collection_select :item_place_id, ItemPlace.all, :id, :name, prompt: "Оберіть місце" %>
  </div>

  <div>
    <%= f.submit "Перекласти річ" %>
  </div>
<% end %>
