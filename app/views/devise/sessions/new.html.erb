<div class="container mt-5">
  <h2 class="mb-4">Вхід</h2>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), class: "needs-validation") do |form| %>
    <div class="mb-3">
      <%= form.label :email, "Email", class: "form-label" %>
      <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "Введіть email" %>
    </div>

    <div class="mb-3">
      <%= form.label :password, "Пароль", class: "form-label" %>
      <%= form.password_field :password, autocomplete: "current-password", class: "form-control", placeholder: "Введіть пароль" %>
    </div>

    <div class="form-check mb-3">
      <% if devise_mapping.rememberable? %>
        <div class="field">
          <%= form.check_box :remember_me, class: "form-check-input" %>
          <%= form.label :remember_me, "Запам’ятати мене", class: "form-check-label" %>
        </div>
      <% end %>
    </div>

    <div class="actions">
      <%= form.submit "Увійти", class: "btn btn-primary" %>
    </div>
  <% end %>

  <div class="mt-3">
    <%= link_to "Забули пароль?", new_password_path(:user), class: "link-secondary" %><br>
    <%= link_to "Реєстрація", new_registration_path(:user), class: "link-secondary" %>
  </div>
</div>

