<div class="container mt-5">
  <h2 class="mb-4">Реєстрація</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), class: "needs-validation") do |form| %>
    <div class="mb-3">
      <%= form.label :email, "Email", class: "form-label" %>
      <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "Введіть email" %>
    </div>

    <div class="mb-3">
      <%= form.label :password, "Пароль", class: "form-label" %>
      <% if @minimum_password_length %>
        <em>(<%= @minimum_password_length %> characters minimum)</em>
      <% end %><br/>
      <%= form.password_field :password, autocomplete: "new-password", class: "form-control", placeholder: "Мінімум 6 символів" %>
    </div>

    <div class="mb-3">
      <%= form.label :password_confirmation, "Підтвердження пароля", class: "form-label" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", placeholder: "Повторіть пароль" %>
    </div>

    <%= form.submit "Зареєструватися", class: "btn btn-success w-100" %>
  <% end %>

  <div class="mt-3">
    <%= link_to "Увійти", new_session_path(resource_name), class: "link-secondary d-block" %>
  </div>
</div>

