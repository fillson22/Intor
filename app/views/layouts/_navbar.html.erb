<nav class="navbar navbar-expand-sm navbar-dark bg-dark">
  <div class="container-fluid">
    <!-- Лого -->
    <%= link_to "Intor", root_path, class: "navbar-brand" %>

    <!-- Кнопка для мобільного меню -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
      aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Основне меню -->
    <div class="collapse navbar-collapse" id="navbarContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <!-- Головна -->
        <li class="nav-item">
          <%= link_to "Головна", root_path, class: "nav-link" %>
        </li>
      </ul>

      <!-- Меню пошуку -->
      <% if user_signed_in? %>
        <%= form_with url: search_path, method: :get, local: true, class: "d-flex" do |form| %>
          <%= form.text_field :q, class: "form-control me-2", placeholder: "Пошук..." %>
          <%= form.submit "Знайти", class: "btn btn-outline-light" %>
        <% end %>
      <% end %>

      <!-- Аутентифікація -->
      <ul class="navbar-nav ms-3">
        <% if user_signed_in? %>
          <li class="nav-item">
            <%= button_to "Вийти", destroy_user_session_path, method: :delete, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Налаштування", edit_user_registration_path, class: "nav-link" %>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to "Увійти", new_user_session_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
