<%= form_with model: item do |form| %>
    <% if @item.errors.any? %>
        <div id="error_explanation">
            <h2><%= pluralize(@item.errors.count, "error") %> prohibited this item from being saved:</h2>
            <ul>
                <% @item.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                <% end %>
            </ul>
        </div>
    <% end %>

    <div class="field">
        <%= form.label "Назва" %>
        <%= form.text_field :name, placeholder: "Введіть назву..." %>
    </div>

    <div class="field">
        <%= form.label "Кількість" %>
        <%= form.number_field :quantity, step: 0.5, min: 0, placeholder: "Зазначте кількість..." %>
    </div>

    <div class="actions">
        <%= form.submit "Зберегти" %>
    </div>
<% end %>